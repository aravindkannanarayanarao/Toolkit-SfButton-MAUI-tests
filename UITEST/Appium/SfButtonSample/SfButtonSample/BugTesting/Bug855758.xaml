<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SfButtonSample.Bugs.Bug855758"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             Title="Bug855758">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center"
            WidthRequest="400">

            <buttons:SfButton
                x:Name="sfButton"
                Clicked="SfButtonClicked"
                Opacity="0.5"
                Text="SfButton" AutomationId="btn1" SemanticProperties.Description="btn1"
                 />
            <Button
                x:Name="CounterBtn"
                Clicked="OnCounterClicked"
                
                SemanticProperties.Hint="Counts the number of times you click"
                Text="Click to Change the SfButton Opacity" AutomationId="btn"  SemanticProperties.Description="btn"/>

        </VerticalStackLayout>
    </ScrollView>



</ContentPage>