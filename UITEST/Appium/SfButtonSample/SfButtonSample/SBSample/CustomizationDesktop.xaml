<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SfButtonSample.SBSample.CustomizationDesktop"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
        xmlns:Toolkitbutton="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:button="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:sliders="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.Toolkit.TabView;assembly=Syncfusion.Maui.Toolkit"
    Title="CustomizationDesktop">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CheckBoxNormalStyle" TargetType="button:SfCheckBox">
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="CheckedColor" Value="#6200EE" />
                <Setter Property="FontFamily" Value="Roboto-Regular" />
            </Style>
            <Style x:Key="EntryNormalStyle" TargetType="Entry">
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="FontFamily" Value="Roboto-Regular" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="Center" WidthRequest="380">
            <Grid.RowDefinitions>
                <RowDefinition Height="150" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Margin="5,10"
                BackgroundColor="#f6f6f8"
                Stroke="Gray"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0.3">
                <Grid>
                    <Toolkitbutton:SfButton
                        x:Name="cartButton"
                        Background="#6200EE"
                        BackgroundImageSource="{Binding BackgroundImage}"
                        CornerRadius="{Binding CornerRadius, Mode=TwoWay}"
                        HeightRequest="50"
                        StrokeThickness="{Binding BorderWidth}"
                        TextColor="{Binding TextColor}"
                        WidthRequest="150">
                        <Toolkitbutton:SfButton.Content>
                            <DataTemplate>
                                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Padding="5,0,5,0">
                                        <Label
                                            FontFamily="SegmentIcon"
                                            FontSize="25"
                                            HorizontalOptions="Start"
                                            HorizontalTextAlignment="Center"
                                            Text="&#xE7BF;"
                                            TextColor="{Binding TextColor}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="1" Padding="0,15,15,15">
                                        <Label
                                            FontSize="15"
                                            HeightRequest="20"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="NoWrap"
                                            Text="{Binding Text}"
                                            TextColor="{Binding TextColor}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </Toolkitbutton:SfButton.Content>
                    </Toolkitbutton:SfButton>
                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                Margin="5,0,5,10"
                BackgroundColor="#f6f6f8"
                Stroke="Gray"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0.3">
                <Grid>
                    <ScrollView VerticalScrollBarVisibility="Never">
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Start">
                            <Core:SfTextInputLayout
                                Margin="10,5,15,0"
                                ContainerType="Outlined"
                                Hint="Text">
                                <Entry
                                    Placeholder="ADD TO CART"
                                    Style="{StaticResource EntryNormalStyle}"
                                    Text="{Binding Text, Mode=TwoWay}" />
                            </Core:SfTextInputLayout>
                            <tabView:SfTabView
                                Margin="15,0"
                                HeightRequest="130"
                                HorizontalOptions="Start"
                                IndicatorBackground="#c6c6c6"
                                TabBarBackground="White"
                                VerticalOptions="Center">
                                <tabView:SfTabItem
                                    FontFamily="Roboto-Regular"
                                    Header="Text Color"
                                    HeightRequest="40">
                                    <tabView:SfTabItem.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">
                                            <On Platform="WinUI" Value="12" />
                                            <On Platform="MacCatalyst" Value="10" />
                                        </OnPlatform>
                                    </tabView:SfTabItem.FontSize>
                                    <tabView:SfTabItem.Content>
                                        <StackLayout HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                            <HorizontalStackLayout Spacing="15">
                                                <Button
                                                    x:Name="TextColorSegment"
                                                    BackgroundColor="#E5E4E2"
                                                    Clicked="TextColorSegment_Clicked"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="TextColorSegment1"
                                                    BackgroundColor="#c6c6c6"
                                                    Clicked="TextColorSegment_Clicked_1"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="TextColorSegment2"
                                                    BackgroundColor="#538eed"
                                                    Clicked="TextColorSegment_Clicked_2"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="TextColorSegment3"
                                                    BackgroundColor="#af2463"
                                                    Clicked="TextColorSegment_Clicked_3"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="TextColorSegment4"
                                                    BackgroundColor="#000000"
                                                    Clicked="TextColorSegment_Clicked_4"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                            </HorizontalStackLayout>
                                        </StackLayout>
                                    </tabView:SfTabItem.Content>
                                </tabView:SfTabItem>
                                <tabView:SfTabItem
                                    FontFamily="Roboto-Regular"
                                    Header="Background"
                                    HeightRequest="40">
                                    <tabView:SfTabItem.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">
                                            <On Platform="WinUI" Value="12" />
                                            <On Platform="MacCatalyst" Value="10" />
                                        </OnPlatform>
                                    </tabView:SfTabItem.FontSize>
                                    <tabView:SfTabItem.Content>
                                        <StackLayout HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                            <HorizontalStackLayout Spacing="15">
                                                <Button
                                                    x:Name="BackgroundColorSegment"
                                                    BackgroundColor="#E5E4E2"
                                                    Clicked="BackgroundColorSegment_Clicked"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="BackgroundColorSegment1"
                                                    BackgroundColor="#c6c6c6"
                                                    Clicked="BackgroundColorSegment_Clicked_1"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="BackgroundColorSegment2"
                                                    BackgroundColor="#538eed"
                                                    Clicked="BackgroundColorSegment_Clicked_2"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="BackgroundColorSegment3"
                                                    BackgroundColor="#af2463"
                                                    Clicked="BackgroundColorSegment_Clicked_3"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="BackgroundColorSegment4"
                                                    BackgroundColor="#000000"
                                                    Clicked="BackgroundColorSegment_Clicked_4"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                            </HorizontalStackLayout>
                                        </StackLayout>
                                    </tabView:SfTabItem.Content>
                                </tabView:SfTabItem>
                                <tabView:SfTabItem
                                    FontFamily="Roboto-Regular"
                                    Header="Border Color"
                                    HeightRequest="40">
                                    <tabView:SfTabItem.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">
                                            <On Platform="WinUI" Value="12" />
                                            <On Platform="MacCatalyst" Value="10" />
                                        </OnPlatform>
                                    </tabView:SfTabItem.FontSize>
                                    <tabView:SfTabItem.Content>
                                        <StackLayout HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                            <HorizontalStackLayout Spacing="15">
                                                <Button
                                                    x:Name="BorderColorSegment"
                                                    BackgroundColor="#E5E4E2"
                                                    Clicked="BorderColorSegment_Clicked"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="BorderColorSegment1"
                                                    BackgroundColor="#c6c6c6"
                                                    Clicked="BorderColorSegment_Clicked_1"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="BorderColorSegment2"
                                                    BackgroundColor="#538eed"
                                                    Clicked="BorderColorSegment_Clicked_2"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="BorderColorSegment3"
                                                    BackgroundColor="#af2463"
                                                    Clicked="BorderColorSegment_Clicked_3"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                                <Button
                                                    x:Name="BorderColorSegment4"
                                                    BackgroundColor="#000000"
                                                    Clicked="BorderColorSegment_Clicked_4"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    WidthRequest="40" />
                                            </HorizontalStackLayout>
                                        </StackLayout>
                                    </tabView:SfTabItem.Content>
                                </tabView:SfTabItem>
                            </tabView:SfTabView>

                            <Label
                                Margin="14,0,33,0"
                                FontAttributes="Bold"
                                FontFamily="Roboto-Regular"
                                Text="Border Thickness" />
                            <Grid Margin="14,10" RowDefinitions="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="35" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Name="borderSlider"
                                    HeightRequest="50"
                                    Maximum="10"
                                    MaximumTrackColor="#E0E0E0"
                                    Minimum="0"
                                    MinimumTrackColor="#6200EE"
                                    ThumbColor="#6200EE"
                                    VerticalOptions="CenterAndExpand"
                                    Value="{Binding BorderWidth, Mode=TwoWay}">
                                    <Slider.Margin>
                                        <OnPlatform x:TypeArguments="Thickness">
                                            <On Platform="WinUI" Value="0,15,0,0" />
                                        </OnPlatform>
                                    </Slider.Margin>
                                </Slider>
                                <Label
                                    Grid.Column="1"
                                    FontFamily="Roboto-Regular"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding BorderWidth}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                            <Label
                                Margin="14,5,33,0"
                                FontAttributes="Bold"
                                FontFamily="Roboto-Regular"
                                Text="Corner Radius" />
                            <Grid
                                Margin="14,10,14,5"
                                Padding="0,5,0,0"
                                RowDefinitions="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="35" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    FontFamily="Roboto-Regular"
                                    HorizontalTextAlignment="Start"
                                    Text="Left"
                                    VerticalTextAlignment="Center" />
                                <Slider
                                    x:Name="leftCornerRadius"
                                    Grid.Column="1"
                                    HeightRequest="50"
                                    Maximum="50"
                                    MaximumTrackColor="#E0E0E0"
                                    Minimum="0"
                                    MinimumTrackColor="#6200EE"
                                    ThumbColor="#6200EE"
                                    VerticalOptions="CenterAndExpand"
                                    Value="{Binding LeftCornerRadius, Mode=TwoWay}">
                                    <Slider.Margin>
                                        <OnPlatform x:TypeArguments="Thickness">
                                            <On Platform="WinUI" Value="0,15,0,0" />
                                        </OnPlatform>
                                    </Slider.Margin>
                                </Slider>
                                <Label
                                    Grid.Column="2"
                                    FontFamily="Roboto-Regular"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding LeftCornerRadius}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                            <Grid
                                Margin="14,10"
                                Padding="0,0,0,0"
                                RowDefinitions="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="35" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    FontFamily="Roboto-Regular"
                                    HorizontalTextAlignment="Start"
                                    Text="Right"
                                    VerticalTextAlignment="Center" />
                                <Slider
                                    x:Name="rightCornerRadius"
                                    Grid.Column="1"
                                    HeightRequest="50"
                                    Maximum="50"
                                    MaximumTrackColor="#E0E0E0"
                                    Minimum="0"
                                    MinimumTrackColor="#6200EE"
                                    ThumbColor="#6200EE"
                                    VerticalOptions="CenterAndExpand"
                                    Value="{Binding RightCornerRadius, Mode=TwoWay}">
                                    <Slider.Margin>
                                        <OnPlatform x:TypeArguments="Thickness">
                                            <On Platform="WinUI" Value="0,15,0,0" />
                                        </OnPlatform>
                                    </Slider.Margin>

                                </Slider>
                                <Label
                                    Grid.Column="2"
                                    FontFamily="Roboto-Regular"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding RightCornerRadius}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                            <Grid Margin="4,0,0,5" HorizontalOptions="Start">
                                <button:SfCheckBox
                                    IsChecked="{Binding CanShowBackgroundImage}"
                                    Style="{StaticResource CheckBoxNormalStyle}"
                                    Text="Show Background Image" />
                            </Grid>
                        </StackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>