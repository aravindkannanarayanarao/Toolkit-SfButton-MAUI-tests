<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SfButtonSample.Features.CommandSample"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:local="clr-namespace:SfButtonSample.ViewModel"
             Title="CommandSample">
    <ContentPage.BindingContext>
        <local:CommandViewModel/>
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <StackLayout >
            <StackLayout  Orientation="Vertical" Spacing="10" VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                <Label Text="Command" />
                <buttons:SfButton Text="OK" Command="{Binding OkCommand}" HeightRequest="50" WidthRequest="300" AutomationId="cmd" SemanticProperties.Description="cmd"/>
                <Label Text="{Binding Label1}" TextColor="Red" />
                <Label Text="Command Parameter" />
                <buttons:SfButton Text="CANCEL" Command="{Binding CancelCommand}" HeightRequest="50" WidthRequest="300" CommandParameter="Exit" AutomationId="cmdp" SemanticProperties.Description="cmdp" />
                <Label Text="{Binding Label2}" TextColor="Red" />
            </StackLayout>
        </StackLayout>

    </ContentPage.Content>
</ContentPage>
