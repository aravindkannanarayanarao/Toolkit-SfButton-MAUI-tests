<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SfButtonSample.Features.IsBusyFeature"
             xmlns:busy="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             Title="IsBusyFeature">
    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="happyTemplate">
                <HorizontalStackLayout>
                    <busy:SfBusyIndicator AnimationType="Cupertino" IsRunning="True" TextColor="White" WidthRequest="80" HeightRequest="60" IndicatorColor="White" VerticalOptions="Center" HorizontalOptions="End"/>
                    <Label Text="Loading..." FontSize="20" HorizontalOptions="Start" VerticalOptions="Center" TextColor="Gold" />
                </HorizontalStackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <buttons:SfButton  CornerRadius="10"  HeightRequest="100" WidthRequest="300"   Content="{x:StaticResource happyTemplate}" Text="SfButton"   />
    </ContentPage.Content>


</ContentPage>