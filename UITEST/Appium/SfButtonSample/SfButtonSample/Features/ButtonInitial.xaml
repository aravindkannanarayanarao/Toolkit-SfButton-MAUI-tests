<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SfButtonSample.Features.ButtonInitial"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             Title="ButtonInitial">
    <ContentPage.Content>
        <ScrollView>
        <VerticalStackLayout>
            <Label Text="InitialButton" />
            <buttons:SfButton BackgroundColor="DarkViolet"/>
                <buttons:SfButton BackgroundColor="DarkGreen"  Stroke="Gold" StrokeThickness="30"/>
                <buttons:SfButton BackgroundColor="DarkGreen"  Stroke="DarkCyan" StrokeThickness="30"/>
                <buttons:SfButton Text="Great" FontAttributes="Bold" Background="AliceBlue" TextColor="Gold"/>

                <buttons:SfButton Text="Great" FontAttributes="Italic" Background="AntiqueWhite" TextColor="DarkGray"/>
                <buttons:SfButton Text="Great" FontSize="25"/>
                <buttons:SfButton Text="Great" HorizontalTextAlignment="End"/>

            </VerticalStackLayout>
    </ScrollView>
    </ContentPage.Content>
</ContentPage>