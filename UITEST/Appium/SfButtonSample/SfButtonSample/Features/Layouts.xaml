<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SfButtonSample.Features.Layouts"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             Title="Layouts">
    <ContentPage.Content>

        <StackLayout>
            <Label Text="Stack Layout" />
            <Label Text="Horizontal allignment" />
            <StackLayout Orientation="Horizontal">
                <buttons:SfButton Text="Media" />
                <buttons:SfButton  Text="Mail" />
                <buttons:SfButton  Text="Contacts"/>
            </StackLayout>
            <Label Text="Vertical allignment" />
            <StackLayout Orientation="Vertical">
                <buttons:SfButton  Text="Home"  />
                <buttons:SfButton  Text="Car"   />
                <buttons:SfButton  Text="User"  />
            </StackLayout>
            <Label Text="Grid Layout" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <buttons:SfButton Text="Grid FirstRow Button" />
                </Grid>
                <buttons:SfButton Text="Grid 2st Row 1st colum Button" Grid.Row="1" Grid.Column="0" />
                <buttons:SfButton Text="Grid 2nd Row 2nd column Button" Grid.Row="1" Grid.Column="1" />
            </Grid>
            <Label Text="Flex Layout" />
            <FlexLayout x:Name="flexLayout"
                         Direction="Row"
                    BackgroundColor="AliceBlue"
                     >
                <buttons:SfButton Text="Button1" />
                <buttons:SfButton Text="Button2" />
                <buttons:SfButton Text="Button3" />
            </FlexLayout>

        </StackLayout>
    </ContentPage.Content>
</ContentPage>
