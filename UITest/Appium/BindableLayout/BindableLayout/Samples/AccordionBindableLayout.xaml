<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BindableLayout.AccordionBindableLayout"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Accordion;assembly=Syncfusion.Maui.Expander"
             xmlns:local="clr-namespace:BindableLayout"
             Title="AccordionBindableLayout">

    <FlyoutPage.BindingContext>
        <local:ViewModel x:Name="viewModel"/>
    </FlyoutPage.BindingContext>

    <FlyoutPage.Flyout>
        <ContentPage Title="Master" AutomationId="masterPage">
            <ContentPage.Content>
                <ScrollView>
                    <ScrollView>

                        <StackLayout>
                            <StackLayout Orientation="Horizontal" HeightRequest="50">
                                <Button AutomationId="Add" Text="Add" Clicked="Add_Clicked" WidthRequest="50" SemanticProperties.Description="Add"/>
                                <Button AutomationId="Insert" Text="Insert" Clicked="Insert_Clicked" WidthRequest="50" SemanticProperties.Description="Insert"/>
                                <Button AutomationId="Remove" Text="Remove" Clicked="Remove_Clicked" WidthRequest="50" SemanticProperties.Description="Remove"/>
                                <Button AutomationId="RemoveAt" Text="RemoveAt" Clicked="RemoveAt_Clicked" WidthRequest="50" SemanticProperties.Description="RemoveAt"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" HeightRequest="50">
                                <Button AutomationId="Clear" Text="Clear" Clicked="Clear_Clicked" WidthRequest="50" SemanticProperties.Description="Clear"/>
                                <Button AutomationId="MoveUp" Text="MoveUp" Clicked="MoveUp_Clicked" WidthRequest="50" SemanticProperties.Description="MoveUp"/>
                                <Button AutomationId="MoveDown" Text="MoveDown" Clicked="MoveDown_Clicked" WidthRequest="50" SemanticProperties.Description="MoveDown" />
                                <Button AutomationId="Replace" Text="Replace" Clicked="Replace_Clicked" WidthRequest="40" SemanticProperties.Description="Replace"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" HeightRequest="50">
                                <Button AutomationId="Single" Text="Single" Clicked="Single_Clicked" WidthRequest="50" SemanticProperties.Description="Single"/>
                                <Button AutomationId="SingleOrNone" Text="SingleOrNone" Clicked="SingleorNone_Clicked" WidthRequest="50" SemanticProperties.Description="SingleOrNone"/>
                                <Button AutomationId="Multiple" Text="Multiple" Clicked="Multiple_Clicked" WidthRequest="50" SemanticProperties.Description="Multiple"/>
                                <Button AutomationId="MultipleOrNone" Text="MultipleOrNone" Clicked="MultipleorNone_Clicked" WidthRequest="50" SemanticProperties.Description="MultipleOrNone"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" HeightRequest="50">
                                <Button AutomationId="ExpandCollapseSingle" Text="ExpColSingle" Clicked="ExpColSingle_Clicked" WidthRequest="50" SemanticProperties.Description="ExpandCollapseSingle"/>
                                <Button AutomationId="ExpandCollapseMultiple" Text="ExpColMultiple" Clicked="ExpColMultiple_Clicked" WidthRequest="50" SemanticProperties.Description="ExpandCollapseMultiple"/>
                                <Button AutomationId="CollapseExpandSingle" Text="ColExpSingle" Clicked="ColExpSingle_Clicked" WidthRequest="50" SemanticProperties.Description="CollapseExpandSingle"/>
                                <Button AutomationId="CollapseExpandMultiple" Text="ColExpMultiple" Clicked="ColExpMultiple_Clicked" WidthRequest="50" SemanticProperties.Description="CollapseExpandMultiple"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" HeightRequest="50">
                                <Button AutomationId="ExpandAll" Text="ExpAll" Clicked="ExpandAll_Clicked" WidthRequest="50" SemanticProperties.Description="ExpandAll"/>
                                <Button AutomationId="CollapseAll" Text="ColAll" Clicked="CollapseAll_Clicked" WidthRequest="50" SemanticProperties.Description="CollapseAll"/>
                                <Button AutomationId="RTL" Text="RTL" Clicked="RTL_Clicked" WidthRequest="50" SemanticProperties.Description="RTL"/>
                                <Button AutomationId="ItemSpacing" Text="Space" Clicked="ItemSpacing_Clicked" WidthRequest="60" SemanticProperties.Description="ItemSpacing"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" HeightRequest="50">
                                <Button AutomationId="Start" Text="Start" Clicked="Start_Clicked" WidthRequest="60" SemanticProperties.Description="Start"/>
                                <Button AutomationId="End" Text="End" Clicked="End_Clicked" WidthRequest="60" SemanticProperties.Description="End"/>
                                <Button AutomationId="None" Text="None" Clicked="None_Clicked" WidthRequest="60" SemanticProperties.Description="None"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" HeightRequest="50">
                                <Button AutomationId="Top" Text="Top" Clicked="Top_Clicked" SemanticProperties.Description="Top"/>
                                <Button AutomationId="MakeVisible" Text="MakeVisible" Clicked="MakeVisible_Clicked" SemanticProperties.Description="MakeVisible"/>
                                <Button AutomationId="ScrollNone" Text="None" Clicked="ScrollNone_Clicked" SemanticProperties.Description="ScrollNone"/>
                            </StackLayout>

                        </StackLayout>
                    </ScrollView>
                </ScrollView>
            </ContentPage.Content>
        </ContentPage>
    </FlyoutPage.Flyout>
    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <ContentPage Title="Detail" Padding="10">
                    <ContentPage.Content>
                        <syncfusion:SfAccordion x:Name="Accordion" BindableLayout.ItemsSource="{Binding Info}" Grid.Row="1">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <syncfusion:AccordionItem>
                                        <syncfusion:AccordionItem.Header>
                                            <Label Text="{Binding Name}" AutomationId="{Binding Name}" FontAttributes="Bold"/>
                                        </syncfusion:AccordionItem.Header>
                                        <syncfusion:AccordionItem.Content>
                                            <Label Text="{Binding Description}"/>
                                        </syncfusion:AccordionItem.Content>
                                    </syncfusion:AccordionItem>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </syncfusion:SfAccordion>
                    </ContentPage.Content>
                </ContentPage>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>