<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSfExpander.PopupOnLoadingPage"
              xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
              xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             Title="PopupOnLoadingPage">
    <VerticalStackLayout>
        <Border StrokeShape="RoundRectangle 8,8,8,8" Margin="{OnPlatform Default='8,0,8,8',WinUI='8,0,6,8',MacCatalyst='8,0,6,8'}" Stroke="#CAC4D0"  StrokeThickness="{OnPlatform MacCatalyst=2,Default=1}" WidthRequest="{OnPlatform MacCatalyst=460,WinUI=340}">
            <syncfusion:SfExpander x:Name="expander" AnimationDuration="200" IsExpanded="True"  HeaderIconPosition="Start">
                <syncfusion:SfExpander.Header>
                    <!--<Grid >
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="48"/>
                             </Grid.RowDefinitions>
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*"/>
                     </Grid.ColumnDefinitions>-->
                    <StackLayout Orientation="Horizontal">
                        <Image Source="dotnet_bot.png" HeightRequest="30" WidthRequest="50"/>
                        <Label CharacterSpacing="0.25" FontFamily="Roboto-Regular"  Text="Expander Header" FontSize="14" Grid.Column="1" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <!--</Grid>-->
                </syncfusion:SfExpander.Header>
                <syncfusion:SfExpander.Content >
                    <Grid Padding="18,8,0,18" >
                        <!--<syncfusion2:SfListView x:Name="listView" 
            ItemsSource="{Binding BookInfo}">
                     <syncfusion2:SfListView.ItemTemplate>
                         <DataTemplate>
                             <Grid Padding="10" >
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="0.4*" />
                                     <RowDefinition Height="0.6*" />
                                 </Grid.RowDefinitions>
                                 <Label Text="{Binding BookName}" FontAttributes="Bold" TextColor="Teal" FontSize="11" />
                                 <Label Grid.Row="1" Text="{Binding BookDescription}" TextColor="Teal" FontSize="10"/>
                             </Grid>
                         </DataTemplate>
                     </syncfusion2:SfListView.ItemTemplate>
                 </syncfusion2:SfListView>-->


                        <Label CharacterSpacing="0.25" FontFamily="Roboto-Regular"  Text="Expander Content" FontSize="14" VerticalOptions="CenterAndExpand"/>

                    </Grid>

                </syncfusion:SfExpander.Content>
            </syncfusion:SfExpander>
        </Border>
    </VerticalStackLayout>
</ContentPage>