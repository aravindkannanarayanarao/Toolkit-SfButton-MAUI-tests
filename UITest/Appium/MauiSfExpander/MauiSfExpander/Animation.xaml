<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSfExpander.Animation"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
             Title="Animation">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout>
                <syncfusion:SfExpander IsExpanded="False" AnimationDuration="500" AnimationEasing="Linear">
                    <syncfusion:SfExpander.Header>
                        <Grid HeightRequest="100">
                            <Label TextColor="#495F6E"
                                Text="Linear"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <Grid Padding="10,10,10,10"
                           BackgroundColor="#FFFFFF">
                            <Label TextColor="#303030"
                                Text="Veg pizza is prepared with the items that meet vegetarian standards by not including any meat or animal tissue products."
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
                <syncfusion:SfExpander AnimationDuration="1000" AnimationEasing="SinIn">
                    <syncfusion:SfExpander.Header>
                        <Grid HeightRequest="50">
                            <Label TextColor="#495F6E"
                                Text="SinIn"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <Grid Padding="10,10,10,10"
                           BackgroundColor="#FFFFFF">
                            <Label TextColor="#303030"
                                Text="Non-veg pizza is prepared by including the meat and animal tissue products."
                                HeightRequest="50"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
                <syncfusion:SfExpander AnimationDuration="500"
                                    AnimationEasing="SinInOut">
                    <syncfusion:SfExpander.Header>
                        <Grid HeightRequest="50">
                            <Label TextColor="#495F6E"
                                Text="SinInOut"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <Grid Padding="10,10,10,10"
                           BackgroundColor="#FFFFFF">
                            <Label TextColor="#303030"
                                Text="Non-veg pizza is prepared by including the meat and animal tissue products."
                                HeightRequest="50"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
                <syncfusion:SfExpander AnimationDuration="500"
                                    AnimationEasing="SinOut">
                    <syncfusion:SfExpander.Header>
                        <Grid HeightRequest="50">
                            <Label TextColor="#495F6E"
                                Text="SinOut"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <Grid Padding="10,10,10,10"
                           BackgroundColor="#FFFFFF">
                            <Label TextColor="#303030"
                                Text="Non-veg pizza is prepared by including the meat and animal tissue products."
                                HeightRequest="50"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
                <syncfusion:SfExpander AnimationDuration="500"
                                    AnimationEasing="None">
                    <syncfusion:SfExpander.Header>
                        <Grid HeightRequest="50">
                            <Label TextColor="#495F6E"
                                Text="None"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <Grid Padding="10,10,10,10"
                           BackgroundColor="#FFFFFF">
                            <Label TextColor="#303030"
                                Text="Non-veg pizza is prepared by including the meat and animal tissue products."
                                HeightRequest="50"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>