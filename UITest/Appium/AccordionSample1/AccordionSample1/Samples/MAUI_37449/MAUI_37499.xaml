<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Accordion;assembly=Syncfusion.Maui.Expander"
             x:Class="AccordionSample1.MAUI_37449.MAUI_37499"
             Title="MAUI_37499">
    <ContentPage.Content>
        <ScrollView>
            <Grid>
                <syncfusion:SfAccordion x:Name="accordion" Grid.Row="0">
                    <syncfusion:SfAccordion.Items>
                        <syncfusion:AccordionItem HeaderBackground="Pink" >
                            <syncfusion:AccordionItem.Header>
                                <Grid>
                                    <Label TextColor="#495F6E" Text="Cheese burger" HeightRequest="100" FontSize="30" FontFamily="Pacifico-Regular" VerticalTextAlignment="Center"/>
                                </Grid>
                            </syncfusion:AccordionItem.Header>
                            <syncfusion:AccordionItem.Content>
                                <Grid Padding="10,10,10,10" BackgroundColor="Beige">
                                    <Label TextColor="#303030" FontFamily="Pacifico-Regular"  FontSize="30" Text="Hamburger accompanied with melted cheese. The term itself is a portmanteau of the words cheese and hamburger." HeightRequest="50" VerticalTextAlignment="Center"/>
                                </Grid>
                            </syncfusion:AccordionItem.Content>
                        </syncfusion:AccordionItem>
                        <syncfusion:AccordionItem HeaderBackground="Blue">
                            <syncfusion:AccordionItem.Header>
                                <Grid>
                                    <Label TextColor="White" Text="Veggie burger" HeightRequest="50" FontSize="30" VerticalTextAlignment="Center" FontFamily="Pacifico-Regular"/>
                                </Grid>
                            </syncfusion:AccordionItem.Header>
                            <syncfusion:AccordionItem.Content>
                                <Grid Padding="10,10,10,10" BackgroundColor="#FFFFFF">
                                    <Label TextColor="#303030" FontFamily="Pacifico-Regular"  FontSize="30" Text="Veggie burger, garden burger, or tofu burger uses a meat analogue, a meat substitute such as tofu, textured vegetable protein." HeightRequest="50" VerticalTextAlignment="Center"/>
                                </Grid>
                            </syncfusion:AccordionItem.Content>
                        </syncfusion:AccordionItem>
                    </syncfusion:SfAccordion.Items>
                </syncfusion:SfAccordion>
            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>