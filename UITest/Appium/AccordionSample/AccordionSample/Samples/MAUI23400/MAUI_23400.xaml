<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:accrod="clr-namespace:Syncfusion.Maui.Accordion;assembly=Syncfusion.Maui.Expander"
              x:Class="AccordionSample.MAUI_23400"
              xmlns:local="clr-namespace:AccordionSample" >
    <ContentPage.BindingContext>
        <local:MAUI_23400_ViewModel/>
    </ContentPage.BindingContext>

    <Grid>
        <CarouselView ItemsSource="{Binding ContentPages}" Loop="False" PeekAreaInsets="50">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <ContentView Content="{Binding .}"/>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
    </Grid>

</ContentPage>