                                        <Slider Minimum="0" Maximum="10" Value="{Binding Path= Progress_Overtaking, Mode=TwoWay}" HorizontalOptions="FillAndExpand"/>
                                        <Label Text="{Binding Path=Progress_Overtaking, Mode=TwoWay}"/>
                                    </StackLayout>
                                </StackLayout>

                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
