                                        <Slider Minimum="0" Maximum="10" Value="{Binding Path=Controls, Mode=TwoWay}" HorizontalOptions="FillAndExpand"/>
                                        <Label Text="{Binding Path=Controls, Mode=TwoWay}"/>
                                    </StackLayout>
                                </StackLayout>

                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
                                    <Label Text="Moving Off"/>
                                    <StackLayout Orientation="Horizontal" Padding="30,5,5,5">
                                        <Slider Minimum="0" Maximum="10" Value="{Binding Path=MovingOff, Mode=TwoWay}" HorizontalOptions="FillAndExpand"/>
                                        <Label Text="{Binding Path=MovingOff, Mode=TwoWay}"/>
                                    </StackLayout>
                                </StackLayout>

                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
                                    <Label Text="Stopping"/>
                                    <StackLayout Orientation="Horizontal" Padding="30,5,5,5">
                                        <Slider Minimum="0" Maximum="10" Value="{Binding Path=Stopping, Mode=TwoWay}" HorizontalOptions="FillAndExpand"/>
                                        <Label Text="{Binding Path=Stopping, Mode=TwoWay}"/>
                                    </StackLayout>
                                </StackLayout>

                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
                                    <Label Text="Normal Driving Position"/>
                                    <StackLayout Orientation="Horizontal" Padding="30,5,5,5">
                                        <Slider Minimum="0" Maximum="10" Value="{Binding Path=NormalDrivingPosition, Mode=TwoWay}" HorizontalOptions="FillAndExpand"/>
                                        <Label Text="{Binding Path=NormalDrivingPosition, Mode=TwoWay}"/>
                                    </StackLayout>
                                </StackLayout>

                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
