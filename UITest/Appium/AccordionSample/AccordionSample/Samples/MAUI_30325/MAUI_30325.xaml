                <accordion:SfAccordion ExpandMode="SingleOrNone">

                    <accordion:AccordionItem>
                        <accordion:AccordionItem.Header>
                            <Grid>
                                <Label Text="Basic" TextColor="Red" FontSize="Large"/>
                            </Grid>
                        </accordion:AccordionItem.Header>

                        <accordion:AccordionItem.Content>
                            <StackLayout Orientation="Vertical">

                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
                                    <Button Text="Add/Edit Note" Grid.Row="0" />
                                    <Editor FontSize="Small" IsReadOnly="True" Text="{Binding SectionBasic}" IsVisible="{Binding SectionBasicVisibility}" />
                                    <Label Text="Cockpit Drills"/>
                                    <StackLayout Orientation="Horizontal" Padding="30,5,5,5">
                                        <Slider Minimum="0" Maximum="10" Value="{Binding Path=Cockpitdrills, Mode=TwoWay}" HorizontalOptions="FillAndExpand"/>
                                        <Label Text="{Binding Path=Cockpitdrills, Mode=TwoWay}" />
                                    </StackLayout>
                                </StackLayout>

                                <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">
                                    <Label Text="Controls"/>
