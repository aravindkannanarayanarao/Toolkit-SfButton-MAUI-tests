<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
             x:Class="AccordionSample.MAUI_24619"
             Title="MAUI_24619">
    
    <ContentPage.Content>
        <expander:SfExpander BackgroundColor="OrangeRed">
            <expander:SfExpander.Header>
                <Grid>
                    <Label AutomationId="Header" Text="Header"></Label>
                </Grid>
            </expander:SfExpander.Header>
            <expander:SfExpander.Content>
                <Grid>
                    <Label Text="Grid supports arranging views into rows and columns. Rows and columns can be set to have proportional sizes or absolute sizes. The Grid layout should not be confused with traditional tables and is not intended to present tabular data. Grid does not have the concept of row, column or cell formatting. Unlike HTML tables, Grid is purely intended for laying out content."></Label>
                </Grid>
            </expander:SfExpander.Content>
        </expander:SfExpander>
    </ContentPage.Content>
</ContentPage>