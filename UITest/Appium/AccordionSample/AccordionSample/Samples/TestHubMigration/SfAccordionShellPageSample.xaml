<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AccordionSample.SfAccordionShellPageSample"
             Title="SfAccordion - ShellPage Navigation">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="SfAccordion ShellPage Navigation Tests" AutomationId="SfAccordion ShellPage Navigation Tests" 
                   SemanticProperties.Description="SfAccordion ShellPage Navigation Tests"
                   FontSize="18"
                   FontAttributes="Bold" />

            <!-- Navigation Buttons Only -->
            <StackLayout Spacing="10" Padding="10" BackgroundColor="#F5F5F5">
                <Label Text="Navigation Options" AutomationId="Navigation Options" SemanticProperties.Description="Navigation Options"
                       FontSize="14" 
                       FontAttributes="Bold" />

                <Button Text="HorizontalStackLayout ShellPage"
                        Clicked="OnHorizontalShellPageClicked"
                        AutomationId="HorizontalStackLayout ShellPage" SemanticProperties.Description="HorizontalStackLayout ShellPage" />

                <Button Text="AbsoluteLayout ShellPage"
                        Clicked="OnAbsoluteShellPageClicked" 
                        AutomationId="AbsoluteLayout ShellPage" SemanticProperties.Description="AbsoluteLayout ShellPage"/>
            </StackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>