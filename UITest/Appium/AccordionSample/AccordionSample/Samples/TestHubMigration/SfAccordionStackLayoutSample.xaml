<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Accordion;assembly=Syncfusion.Maui.Expander"
             x:Class="AccordionSample.SfAccordionStackLayoutSample"
             Title="SfAccordion - StackLayout">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            
            <Label Text="SfAccordion Test Cases"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#000000" />

            <!-- StackLayout Case -->
            <StackLayout AutomationId="StackLayout"
                         Padding="10"
                         Spacing="5"
                         BackgroundColor="#F0F0F0">
                <Label Text="StackLayout Case"
                       FontSize="14"
                       FontAttributes="Bold" />
                <sf:SfAccordion AutomationId="AccordionStackLayout">
                    <sf:AccordionItem>
                        <sf:AccordionItem.Header>
                            <Label Text="Item 1" />
                        </sf:AccordionItem.Header>
                        <sf:AccordionItem.Content>
                             <Label Text="Content 1" Padding="10" />
                        </sf:AccordionItem.Content>
                    </sf:AccordionItem>
                    <sf:AccordionItem>
                        <sf:AccordionItem.Header>
                            <Label Text="Item 2" AutomationId="Item 2" SemanticProperties.Description="Item 2"/>
                        </sf:AccordionItem.Header>
                        <sf:AccordionItem.Content>
                            <Label Text="Content 2" Padding="10" />
                        </sf:AccordionItem.Content>
                    </sf:AccordionItem>
                    <sf:AccordionItem>
                        <sf:AccordionItem.Header>
                            <Label Text="Item 3" />
                        </sf:AccordionItem.Header>
                        <sf:AccordionItem.Content>
                            <Label Text="Content 3" Padding="10" />
                        </sf:AccordionItem.Content>
                    </sf:AccordionItem>
                </sf:SfAccordion>
            </StackLayout>

            <!-- VerticalStackLayout Case -->
            <VerticalStackLayout AutomationId="VerticalStackLayout"
                                 Padding="10"
                                 Spacing="5"
                                 BackgroundColor="#E8F4F8">
                <Label Text="VerticalStackLayout Case"
                       FontSize="14"
                       FontAttributes="Bold" />
                <sf:SfAccordion AutomationId="AccordionVerticalStackLayout">
                    <sf:AccordionItem>
                        <sf:AccordionItem.Header>
                            <Label Text="Vertical Item 1" />
                        </sf:AccordionItem.Header>
                        <sf:AccordionItem.Content>
                            <Label Text="Vertical Content 1" Padding="10" />
                        </sf:AccordionItem.Content>
                    </sf:AccordionItem>
                    <sf:AccordionItem>
                        <sf:AccordionItem.Header>
                            <Label Text="Vertical Item 2" AutomationId="Vertical Item 2" SemanticProperties.Description="Vertical Item 2" />
                        </sf:AccordionItem.Header>
                        <sf:AccordionItem.Content>
                            <Label Text="Vertical Content 2" Padding="10" />
                        </sf:AccordionItem.Content>
                    </sf:AccordionItem>
                    <sf:AccordionItem>
                        <sf:AccordionItem.Header>
                            <Label Text="Vertical Item 3" />
                        </sf:AccordionItem.Header>
                        <sf:AccordionItem.Content>
                            <Label Text="Vertical Content 3" Padding="10" />
                        </sf:AccordionItem.Content>
                    </sf:AccordionItem>
                </sf:SfAccordion>
            </VerticalStackLayout>

            <VerticalStackLayout Padding="10" Spacing="10">

                <!-- Title text OUTSIDE the HorizontalStackLayout -->
                <Label Text="HorizontalStackLayout"
                       FontSize="14"
                       FontAttributes="Bold" />

                <!-- Horizontal layout containing ONLY the accordion -->
                <HorizontalStackLayout Padding="10"
                           Spacing="5"
                           BackgroundColor="#FFF8E8">

                    <sf:SfAccordion WidthRequest="200">

                        <sf:AccordionItem>
                            <sf:AccordionItem.Header>
                                <Label Text="H Item 1" />
                            </sf:AccordionItem.Header>
                            <sf:AccordionItem.Content>
                                <Label Text="H Content 1"
                                       Padding="10"
                                       FontSize="12" />
                            </sf:AccordionItem.Content>
                        </sf:AccordionItem>

                        <sf:AccordionItem>
                            <sf:AccordionItem.Header>
                                <Label Text="H Item 2" AutomationId="H Item 2" SemanticProperties.Description="H Item 2"/>
                            </sf:AccordionItem.Header>
                            <sf:AccordionItem.Content>
                                <Label Text="H Content 2"
                                       Padding="10"
                                       FontSize="12" />
                            </sf:AccordionItem.Content>
                        </sf:AccordionItem>

                    </sf:SfAccordion>

                </HorizontalStackLayout>

            </VerticalStackLayout>

            <!-- Grid replacing AbsoluteLayout -->
            <Grid AutomationId="AbsoluteLayout"
                  Padding="10"
                  BackgroundColor="#F0E8F8"
                  RowDefinitions="40, Auto">

                <!-- Title -->
                <Label Text="AbsoluteLayout Case"
                       FontSize="14"
                       FontAttributes="Bold"
                       Grid.Row="0" />

                <!-- Accordion -->
                <sf:SfAccordion AutomationId="AccordionAbsoluteLayout"
                    Grid.Row="1">

                    <sf:AccordionItem>
                        <sf:AccordionItem.Header>
                            <Label Text="Absolute Item 1" />
                        </sf:AccordionItem.Header>
                        <sf:AccordionItem.Content>
                            <Label Text="Absolute Content 1" Padding="10" />
                        </sf:AccordionItem.Content>
                    </sf:AccordionItem>

                    <sf:AccordionItem>
                        <sf:AccordionItem.Header>
                            <Label Text="Absolute Item 2" AutomationId="Absolute Item 2" SemanticProperties.Description="Absolute Item 2"/>
                        </sf:AccordionItem.Header>
                        <sf:AccordionItem.Content>
                            <Label Text="Absolute Content 2" Padding="10" />
                        </sf:AccordionItem.Content>
                    </sf:AccordionItem>
                    
                </sf:SfAccordion>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
