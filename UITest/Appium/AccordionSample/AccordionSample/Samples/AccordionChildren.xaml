                            <Button AutomationId="Replace" Text="Replace" Clicked="Replace_Clicked" WidthRequest="40"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" HeightRequest="50">
                            <Button AutomationId="Single" Text="Single" Clicked="Single_Clicked" WidthRequest="50"/>
                            <Button AutomationId="SingleOrNone" Text="SingleOrNone" Clicked="SingleorNone_Clicked" WidthRequest="50"/>
                            <Button AutomationId="Multiple" Text="Multiple" Clicked="Multiple_Clicked" WidthRequest="50"/>
                            <Button AutomationId="MultipleOrNone" Text="MultipleOrNone" Clicked="MultipleorNone_Clicked" WidthRequest="50"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" HeightRequest="50">
                            <Button AutomationId="ExpandCollapseSingle" Text="ExpColSingle" Clicked="ExpColSingle_Clicked" WidthRequest="50"/>
