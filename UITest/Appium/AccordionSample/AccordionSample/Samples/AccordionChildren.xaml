                            <Button AutomationId="RTL" Text="RTL" Clicked="RTL_Clicked"/>
                            <Button AutomationId="BringIntoView" Text="Bring" Clicked="BringIntoView_Clicked"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" HeightRequest="50">
                            <Button AutomationId="Start" Text="Start" Clicked="Start_Clicked" WidthRequest="60"/>
                            <Button AutomationId="End" Text="End" Clicked="End_Clicked" WidthRequest="60"/>
                            <Button AutomationId="None" Text="None" Clicked="None_Clicked" WidthRequest="60"/>
