                            <Button AutomationId="MakeVisible" Text="MakeVisible" Clicked="MakeVisible_Clicked"/>
                            <Button AutomationId="ScrollNone" Text="None" Clicked="ScrollNone_Clicked"/>
                        </StackLayout>

                    </StackLayout>
                </ScrollView>
            </ContentPage.Content>
