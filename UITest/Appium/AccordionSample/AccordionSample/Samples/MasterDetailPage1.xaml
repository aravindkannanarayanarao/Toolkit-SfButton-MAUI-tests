                                    <x:String>Single</x:String>
                                    <x:String>SingleOrNone</x:String>
                                    <x:String>Multiple</x:String>
                                    <x:String>MultipleOrNone</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        <Picker AutomationId="expandCollapse" x:Name="expandCollapsePicker" Title="ExpandCollapse " SelectedIndex="0" SelectedIndexChanged="ExpandCollapse_SelectedIndexChanged">
