                                    <x:String>End</x:String>
                                    <x:String>None</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        <Picker x:Name="collectionChange" AutomationId="collectionChange" SelectedIndex="1" Title="CollectionChange" SelectedIndexChanged="collectionChange_SelectedIndexChanged">
