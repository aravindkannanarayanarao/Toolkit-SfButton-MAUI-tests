<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:listview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
             x:Class="AccordionSample.Samples.MAUI_27222.ExpanderIssue"
             Title="ExpanderIssue">
    <!--ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness"
            iOS="3, 20, 3, 10"
            Android="3"/>
    </ContentPage.Padding>-->

    <ContentPage.Content>
        <StackLayout Orientation="Vertical">
            <Button Text="ScrollToEnd" Clicked="Button_Clicked"/>

            <listview:SfListView x:Name="SubLV"
                        ScrollBarVisibility="Always"
                        ItemSpacing="2" SelectionMode="None"
                        AutoFitMode="DynamicHeight" >

                <listview:SfListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.View>
                                <Frame x:Name="frame" CornerRadius="2"
                                 Padding="1" Margin="1"
                                 BorderColor="Black"
                                 HasShadow="true">
                                    <Grid Padding="2" Margin="1">

                                        <expander:SfExpander HeaderIconPosition="End"
                                       IsExpanded="{Binding IsExpanded,Mode=TwoWay}"
                                       IsEnabled="True">
                                            <expander:SfExpander.Header Padding="3,3,3,3">
                                                <Grid>
                                                    <Label Text="{Binding accordionText}"
                                                 HorizontalOptions="FillAndExpand"
                                                 LineBreakMode="WordWrap" />
                                                </Grid>
                                            </expander:SfExpander.Header>

                                            <expander:SfExpander.Content>
                                                <Grid Padding="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                        <RowDefinition Height="*"></RowDefinition>

                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>

                                                    <Frame x:Name="BFrame" Grid.Row="0" Grid.Column="0" Padding="2" Margin="2">
                                                        <Grid Padding="2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="24"></RowDefinition>
                                                                <RowDefinition Height="24"></RowDefinition>
                                                                <RowDefinition Height="Auto"></RowDefinition>
                                                                <RowDefinition Height="Auto"></RowDefinition>
                                                                <RowDefinition Height="24"></RowDefinition>
                                                                <RowDefinition Height="Auto"></RowDefinition>
                                                                <RowDefinition Height="24"></RowDefinition>

                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80"></ColumnDefinition>
                                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                                                <ColumnDefinition Width="30"></ColumnDefinition>
                                                                <ColumnDefinition Width="5"></ColumnDefinition>
                                                            </Grid.ColumnDefinitions>

                                                            <Label Grid.Row="0" Grid.Column="0" Text="City" FontSize="18"/>
                                                            <Label Grid.Row="0" Grid.Column="1"  Grid.ColumnSpan ="2"
                                                            Text="{Binding sub.city}" FontSize="18"/>

                                                            <Label Grid.Row="1" Grid.Column="0" Text="Num" FontSize="18"/>
                                                            <Label Grid.Row="1" Grid.Column="1"   Grid.ColumnSpan ="2"
                                                            Text="{Binding sub.numDisplay}" FontSize="18"
                                                            x:Name="Label_wonum"/>

                                                            <Label Grid.Row="2" Grid.Column="0" Text="Addr" FontSize="18"/>
                                                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding sub.addr}" FontSize="18"/>

                                                            <Label Grid.Row="3" Grid.Column="0" Text="Mat" FontSize="18"/>
                                                            <Label Grid.Row="3" Grid.Column="1"  Text="{Binding sub.mat}" FontSize="18"/>

                                                            <Label Grid.Row="4" Grid.Column="0" Text="Lead" FontSize="18"/>
                                                            <Label Grid.Row="4" Grid.Column="1"  Grid.ColumnSpan ="2"  Text="{Binding sub.lead}" FontSize="18"/>

                                                            <Label Grid.Row="5" Grid.Column="0" Text="Start" FontSize="18"/>
                                                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding sub.wstarttimeWithDuration}" FontSize="18"
                                                            LineBreakMode="WordWrap"/>

                                                            <Label Grid.Row="6" Grid.Column="0" Text="Status" FontSize="18"/>
                                                            <Label Grid.Row="6" Grid.Column="1"  Grid.ColumnSpan ="2"  Text="{Binding sub.wstatus}" FontSize="18"/>

                                                        </Grid>
                                                    </Frame>

                                                    <Frame x:Name="CFrame" Grid.Row="1" Grid.Column="0"  Padding="2" Margin="2">
                                                        <Grid Padding="2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="24"></RowDefinition>

                                                                <RowDefinition Height="Auto"></RowDefinition>
                                                                <RowDefinition Height="24"></RowDefinition>
                                                                <RowDefinition Height="24"></RowDefinition>
                                                                <RowDefinition Height="24"></RowDefinition>
                                                                <RowDefinition Height="{Binding AttachmentHeight}"></RowDefinition>

                                                                <RowDefinition Height="Auto"></RowDefinition>
                                                                <RowDefinition Height="100"></RowDefinition>
                                                                <RowDefinition Height="Auto"></RowDefinition>
                                                                <RowDefinition Height="100"></RowDefinition>
                                                                <RowDefinition Height="Auto"></RowDefinition>

                                                                <RowDefinition Height="Auto"></RowDefinition>
                                                                <RowDefinition Height="Auto"></RowDefinition>
                                                                <RowDefinition Height="Auto"></RowDefinition>

                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80"></ColumnDefinition>
                                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                                            </Grid.ColumnDefinitions>

                                                            <Label Grid.Row="0" Grid.Column="0" Text="Desc" FontSize="18"/>
                                                            <Label Grid.Row="0" Grid.Column="1"
                                                            Text="{Binding sub.wdesc}" FontSize="18"/>

                                                            <Label Grid.Row="1" Grid.Column="0" Text="Task" FontSize="18"/>
                                                            <Label Grid.Row="1" Grid.Column="1"
                                                            Text="{Binding sub.desc}" FontSize="18"/>

                                                            <Label Grid.Row="2" Grid.Column="0" Text="FM" FontSize="18"/>
                                                            <Label Grid.Row="2" Grid.Column="1"
                                                            Text="{Binding sub.foreman}" FontSize="18"/>

                                                            <Label Grid.Row="3" Grid.Column="0" Text="Name" FontSize="18"/>
                                                            <Label Grid.Row="3" Grid.Column="1"
                                                            Text="{Binding sub.name}" FontSize="18"/>

                                                            <Label Grid.Row="4" Grid.Column="0" Text="Attachments"
                                                            Grid.ColumnSpan="2"
                                                            FontSize="18"/>
                                                            <ListView ItemsSource="{Binding ocAtt}" Grid.Row="5" Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            IsVisible="True" HasUnevenRows="True">
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextCell Text="{Binding file_name}"/>
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>

                                                            <Label Grid.Row="6" Grid.Column="0" Text="Notes" FontSize="18"
                                                            IsEnabled="{Binding IsNotesEnabled}"/>

                                                            <Frame Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                                               Padding="2"   >
                                                                <Editor   x:Name="NotesEditor"
                                                                Text="{Binding sub.note, Mode=TwoWay}" FontSize="18"
                                                                HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                                                IsEnabled="True"/>
                                                            </Frame>


                                                            <Label Grid.Row="8" Grid.Column="0"  Grid.ColumnSpan="2"
                                                            Text="More Notes" FontSize="18"
                                                            IsEnabled="{Binding IsNotesEnabled}"/>

                                                            <Frame Padding="2"
                                                            Grid.Row="9" Grid.Column="0"
                                                            Grid.ColumnSpan="2" >

                                                                <Editor  x:Name="MoreNotesEditor"                                                                        
                                                                Text="{Binding sub.morenotes, Mode=TwoWay}" FontSize="18"
                                                                HorizontalOptions="FillAndExpand"  VerticalOptions="FillAndExpand"
                                                                IsEnabled="True"/>
                                                            </Frame>

                                                            <Label x:Name="SaveMess" Grid.Row="10" Grid.Column="0"
                                                               Grid.ColumnSpan="2"
                                                            FontSize="18" Text="{Binding SaveMsg}"
                                                            HorizontalOptions="Center"
                                                            IsVisible="{Binding SaveMsgVisibility}"
                                                            LineBreakMode="WordWrap"/>

                                                            <StackLayout Orientation="Horizontal"
                                                                Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2">
                                                                <Button x:Name="CloseMaster" Text="Close All"
                                                                 IsEnabled="True"
                                                                 IsVisible="True"
                                                                 Margin="10,0,0,0"/>
                                                            </StackLayout>

                                                            <StackLayout Orientation="{Binding stackOrientation}"
                                                            Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" >

                                                                <StackLayout Orientation="Horizontal" >

                                                                    <Button x:Name="EmailPM" Text="Previous" BackgroundColor="LightBlue"
                                                                    IsEnabled="True"
                                                                    VerticalOptions="Center"
                                                                    Margin="10,0,0,0"/>

                                                                    <Button x:Name="EmailPMA" Text="Next" BackgroundColor="LightBlue"
                                                                    IsEnabled="True"
                                                                    VerticalOptions="Center"
                                                                    Margin="5,0,0,0"/>
                                                                </StackLayout>
                                                            </StackLayout >

                                                            <StackLayout Orientation="Horizontal"
                                                            Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"
                                                            Margin="0,5,0,0">
                                                                <Button x:Name="SaveCompleteButton" WidthRequest="160"
                                                                BackgroundColor="LightBlue"
                                                                BorderWidth="2"
                                                                Text="Save and Complete"   HorizontalOptions="Center"
                                                                CommandParameter="{Binding sub.myID}"
                                                                IsVisible="True"
                                                                IsEnabled="True"/>

                                                                <Button x:Name="SaveNoteButton" WidthRequest="100"
                                                                BackgroundColor="LightBlue"
                                                                BorderWidth="2"
                                                                Text="Save Note"   HorizontalOptions="Center"
                                                                IsVisible="True"
                                                                IsEnabled="True"/>
                                                            </StackLayout >
                                                        </Grid>
                                                    </Frame>
                                                </Grid>
                                            </expander:SfExpander.Content>
                                        </expander:SfExpander>
                                    </Grid>
                                </Frame>
                            </ViewCell.View>
                        </ViewCell>
                    </DataTemplate>
                </listview:SfListView.ItemTemplate>
            </listview:SfListView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>