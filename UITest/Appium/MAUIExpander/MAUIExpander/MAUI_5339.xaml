<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIExpander.MAUI_5339"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
             Title="MAUI_5339">
    <ContentPage.Content>

        <ScrollView>
        <StackLayout>
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*,*">
                    <Button Text="ChangeHeader"
                            HeightRequest="50"
                            Grid.Column="0"
                            Grid.Row="0"
                            Clicked="Button_Clicked" />
                    <Button Text="ChangeHeaderBackground"
                            HeightRequest="50"
                            Grid.Column="1"
                            Grid.Row="0"
                            Clicked="Button_Clicked_1" />
                    <Button Text="IconPositionEnd"
                            HeightRequest="50"
                            Grid.Column="2"
                            Grid.Row="0"
                            Clicked="Button_Clicked_2" />
                    <Button Text="IconPositionStart"
                            HeightRequest="50"
                            Grid.Column="0"
                            Grid.Row="1"
                            Clicked="Button_Clicked_3" />
                    <Button Text="SetHeaderBackGround"
                            HeightRequest="50"
                            Grid.Column="1"
                            Grid.Row="1"
                            Clicked="Button_Clicked_4" />
                    <Button Text="IconPositionNone"
                            Clicked="Button_Clicked_5"
                            Grid.Column="2"
                            Grid.Row="1"
                            HeightRequest="50" />
                    <Button Text="ChangeHeaderNull"
                            Clicked="Button_Clicked_6"
                            Grid.Column="1"
                            Grid.Row="2"
                            HeightRequest="50" />
                    <Button Text="IconColor"
                            Clicked="Button_Clicked_7"
                            Grid.Column="0"
                            Grid.Row="2"
                            HeightRequest="50" />
                    <Button Text="Header2Change"
                            Clicked="Button_Clicked_8"
                            Grid.Column="2"
                            Grid.Row="2"
                            HeightRequest="50" />
                    <Button Text="isExpander"
                            Clicked="Button_Clicked_9"
                            HeightRequest="50"
                            Grid.Row="3"
                            Grid.Column="0" />

                </Grid>
                <syncfusion:SfExpander x:Name="expander" HeaderBackground="LightBlue" HeaderIconColor="BlueViolet">
                    <syncfusion:SfExpander.Header >
                        <Grid HeightRequest="50">
                            <Label TextColor="#495F6E"
                                   Text="Veg Pizza"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <Grid Padding="10,10,10,10"
                              BackgroundColor="#FFFFFF">
                            <Label TextColor="#303030"
                                   Text="Veg pizza is prepared with the items that meet vegetarian standards by not including any meat or animal tissue products."
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
                <syncfusion:SfExpander x:Name="expander1" HeaderIconColor="Red" HeaderIconPosition="Start">
                    <syncfusion:SfExpander.Header>
                        <Grid HeightRequest="50">
                            <Label TextColor="#495F6E"
                                   Text="Non-veg Pizza"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <Grid Padding="10,10,10,10"
                              BackgroundColor="#FFFFFF">
                            <Label TextColor="#303030"
                                   Text="Non-veg pizza is prepared by including the meat and animal tissue products."
                                   HeightRequest="50"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
                <syncfusion:SfExpander x:Name="expander2"
                                       HeaderIconColor="Red"
                                       HeaderIconPosition="None">
                    <syncfusion:SfExpander.Header>
                        <Grid HeightRequest="50">
                            <Label TextColor="#495F6E"
                                   Text="Non-veg Pizza"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <Grid Padding="10,10,10,10"
                              BackgroundColor="#FFFFFF">
                            <Label TextColor="#303030"
                                   Text="Non-veg pizza is prepared by including the meat and animal tissue products."
                                   HeightRequest="50"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
                <syncfusion:SfExpander x:Name="expander3"
                                       HeaderIconColor="Red"
                                       HeaderIconPosition="Start">
                    <syncfusion:SfExpander.Header>
                        <StackLayout>
                            <Label TextColor="#495F6E"
                                   Text="Non-veg Pizza"
                                   VerticalTextAlignment="Center" />
                        </StackLayout>
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <Grid Padding="10,10,10,10"
                              BackgroundColor="#FFFFFF">
                            <Label TextColor="#303030"
                                   Text="Non-veg pizza is prepared by including the meat and animal tissue products."
                                   HeightRequest="50"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
                <syncfusion:SfExpander x:Name="expander4"
                                       HeaderIconColor="Red"
                                       HeaderIconPosition="End">
                    <syncfusion:SfExpander.Header>
                        <Grid HeightRequest="50">
                            <Image Source="people_circle1.png" />
                        </Grid>
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <Grid Padding="10,10,10,10"
                              BackgroundColor="#FFFFFF">
                            <Label TextColor="#303030"
                                   Text="Non-veg pizza is prepared by including the meat and animal tissue products."
                                   HeightRequest="50"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>