<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIExpander.GettingStarted"
             Title="GettingStarted"
             xmlns:imageExtension="clr-namespace:SampleBrowser.Maui.Base.Converters;assembly=SampleBrowser.Maui.Base"
             xmlns:local="clr-namespace:MAUIExpander"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
             xmlns:ListView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView">
    <ContentPage.Resources>
        <imageExtension:SfImageSourceConverter x:Key="imageconverter" />
        <local:FoodSelectionIconConverter x:Key="foodSelectionIconConverter" />
    </ContentPage.Resources>
    <ContentPage.BindingContext>
        <local:LinearLayoutViewModel x:Name="viewModel" />
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <StackLayout>
            <syncfusion:SfExpander>
                <syncfusion:SfExpander.Header>
                    <Grid ColumnDefinitions="Auto,*"
                          Padding="10">
                        <Label Grid.Column="0"
                               Text="&#xe71D;"
                               FontSize="26"
                               TextColor="#666666"
                               FontFamily='{OnPlatform Android=ListViewFontIcons.ttf#,UWP=ListViewFontIcons.ttf#ListViewFontIcons,MacCatalyst=ListViewFontIcons,iOS=ListViewFontIcons}'
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Margin="10,0,0,0"
                               Text="Breakfast"
                               TextColor="#000000"
                               FontSize="14"
                               FontFamily="Roboto-Medium"
                               CharacterSpacing="0.1"
                               VerticalOptions="Center"
                               HorizontalOptions="Start" />
                    </Grid>
                </syncfusion:SfExpander.Header>
                <syncfusion:SfExpander.Content>
                    <ListView:SfListView ItemsSource="{Binding BreakfastMenu}"
                                         ItemSize="50">
                        <ListView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <Grid BackgroundColor="#FFFFFF">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference viewModel}, Path=SelectCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <Label Text="{Binding IsSelected,Converter={StaticResource foodSelectionIconConverter}}"
                                           FontSize="16"
                                           FontFamily='{OnPlatform Android=ListViewFontIcons.ttf#,UWP=ListViewFontIcons.ttf#ListViewFontIcons,MacCatalyst=ListViewFontIcons,iOS=ListViewFontIcons}'
                                           TextColor="#666666"
                                           Margin="40,0,12,0"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center" />

                                    <Label Grid.Column="1"
                                           Text="{Binding FoodName}"
                                           FontSize="14"
                                           TextColor="#000000"
                                           CharacterSpacing="0.25"
                                           FontFamily="Roboto-Regular"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView:SfListView.ItemTemplate>
                    </ListView:SfListView>
                </syncfusion:SfExpander.Content>
            </syncfusion:SfExpander>
            <syncfusion:SfExpander>
                <syncfusion:SfExpander.Header>
                    <Grid>
                        <Label Grid.Column="0"
                               FontFamily="Roboto-Medium"
                               CharacterSpacing="0.25"
                               Text="Recipes"
                               TextColor="#E3000000"
                               FontSize="16"
                               Margin="16,10,0,0" />
                    </Grid>
                </syncfusion:SfExpander.Header>
                <syncfusion:SfExpander.Content>
                    <Grid>
                        <ListView:SfListView x:Name="listView"
                                             ItemsSource="{Binding RecipeInfo}"
                                             ScrollBarVisibility="Always"
                                             SelectionMode="None"
                                             ItemSize="94">

                            <ListView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="1" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="94" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Frame HorizontalOptions="Center"
                                               IsClippedToBounds="True"
                                               CornerRadius="4"
                                               HasShadow="False"
                                               Grid.Row="0"
                                               Grid.Column="0"
                                               HeightRequest="72"
                                               WidthRequest="72"
                                               Padding="0">
                                            <Image Grid.Column="0"
                                                   Grid.Row="0"
                                                   Source="{Binding RecipeImage,Converter={StaticResource imageconverter}}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="FillAndExpand"
                                                   HeightRequest="72"
                                                   WidthRequest="72"
                                                   Aspect="Fill" />
                                        </Frame>
                                        <Grid Grid.Row="0"
                                              Grid.Column="1"
                                              VerticalOptions="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="{Binding RecipeName}"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="#DE000000"
                                                   FontFamily="Roboto-Medium"
                                                   FontSize="{OnPlatform Android={OnIdiom Phone=15, Tablet=22}, iOS=16, UWP=14,MacCatalyst=16}"
                                                   CharacterSpacing="0.1" />
                                            <Label Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding RecipeTime}"
                                                   TextColor="#666666"
                                                   FontSize="{OnPlatform Default=10,UWP=12,MacCatalyst=12}"
                                                   FontFamily="Roboto-Regular"
                                                   HorizontalOptions="End"
                                                   CharacterSpacing="0.15"
                                                   Margin="0,0,11,0" />
                                            <Label Grid.Row="1"
                                                   Grid.Column="0"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="#666666"
                                                   LineHeight="{OnPlatform iOS={OnIdiom Tablet=1.2, Default=1.025}, Default=1.2}"
                                                   Text="{Binding RecipeDescription}"
                                                   FontFamily="Roboto-Regular"
                                                   FontSize="14"
                                                   CharacterSpacing="0.1"
                                                   Margin="0,4,0,0" />
                                        </Grid>
                                        <BoxView Grid.Row="1"
                                                 Grid.Column="1"
                                                 BackgroundColor="LightGray"
                                                 HeightRequest="1"
                                                 VerticalOptions="End" />
                                    </Grid>
                                </DataTemplate>
                            </ListView:SfListView.ItemTemplate>
                        </ListView:SfListView>
                    </Grid>
                </syncfusion:SfExpander.Content>
            </syncfusion:SfExpander>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>